# EcoWatch AI — Backend Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./ecowatch.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecowatch

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# JWT access token expiry in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Legacy image migration ────────────────────────────────────────────────────
# Only set this when migrating images from an older filesystem-backed release.
# LEGACY_UPLOAD_DIR=uploads

# Maximum image upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# ── AI model ──────────────────────────────────────────────────────────────────
# Absolute path to the YOLO checkpoint file (.pt).
# Leave empty or unset to run in model-unavailable mode.
MODEL_PATH=

# Minimum confidence threshold for accepting a detection (0.0–1.0)
MODEL_CONFIDENCE_THRESHOLD=0.25

# ── Hotspot clustering ────────────────────────────────────────────────────────
# Haversine clustering radius in metres
HOTSPOT_CLUSTER_RADIUS_M=30

# Minimum report count per severity level
HOTSPOT_LOW_MIN=1
HOTSPOT_MEDIUM_MIN=3
HOTSPOT_HIGH_MIN=6
HOTSPOT_CRITICAL_MIN=10

# ── Miscellaneous ─────────────────────────────────────────────────────────────
# Environment label: development | production
ENVIRONMENT=development
